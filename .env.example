# Optional in Phase 1. If supplied, URLs must be valid HTTP(S) origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Configure both together in Phase 5. Blank values are treated as unconfigured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Reserved for future server-only tasks. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
